{
  "name": "@markdown2/marked",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Markdown2 as a drop-in library with a marked.js-compatible API, plus a permission-aware view.",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite build --watch",
    "preview": "vite preview --port 4174",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "age-encryption": "^0.2.4"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}